# RescueBite AI — Backend Environment Variables (Vercel Serverless / Production)

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, ensure 0.0.0.0/0 (Allow from Anywhere) is whitelisted so Vercel Serverless Functions can connect.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rescuebite?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_production_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Vercel Frontend URL)
# Can be your frontend Vercel URL, custom domain, or a comma-separated list of URLs:
# CORS_ORIGIN=https://rescue-bite-ai.vercel.app,http://localhost:5173
CORS_ORIGIN=https://rescue-bite-ai.vercel.app

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# RescueBite ML Service URL (FastAPI) - Optional / Fallback
ML_API_URL=http://localhost:8000

# Email Service (SMTP for Password Reset OTP & Notifications)
# Note: On Vercel, standard SMTP (ports 465 and 587) works reliably.
# Option 1: Quick Gmail configuration (Recommended for Gmail)
# Create an App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
EMAIL_FROM="RescueBite AI" <noreply@rescuebite.org>

# Option 2: Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
