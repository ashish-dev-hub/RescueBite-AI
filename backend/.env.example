# RescueBite AI — Backend Environment Variables

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, ensure 0.0.0.0/0 (Allow from Anywhere) is whitelisted so Render can connect.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rescuebite?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_production_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Render -> Vercel)
# Can be your Vercel URL, custom domain, or a comma-separated list of URLs:
# CORS_ORIGIN=https://rescuebite.vercel.app,http://localhost:5173
CORS_ORIGIN=https://rescuebite.vercel.app

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# RescueBite ML Service URL (FastAPI)
ML_API_URL=http://localhost:8000

# Email Service (SMTP for Password Reset & Notifications)
# Option 1: Custom SMTP (SendGrid, Brevo, AWS SES, Mailgun, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# Option 2: Quick Gmail service configuration
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="RescueBite AI" <noreply@rescuebite.org>
