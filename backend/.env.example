# RescueBite AI — Backend Environment Variables

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, ensure 0.0.0.0/0 (Allow from Anywhere) is whitelisted so Render can connect.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rescuebite?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_production_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Render -> Vercel)
# Can be your Vercel URL, custom domain, or a comma-separated list of URLs:
# CORS_ORIGIN=https://rescuebite.vercel.app,http://localhost:5173
CORS_ORIGIN=https://rescuebite.vercel.app
