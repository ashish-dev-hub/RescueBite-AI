# RescueBite AI — Frontend Environment Variables
# In Vite, variables exposed to the client bundle MUST be prefixed with VITE_

# Local Development:
# Leave blank or set to /api (Vite's proxy in vite.config.js automatically forwards /api to http://127.0.0.1:5000)
# VITE_API_BASE_URL=/api

# Production on Vercel:
# Set this in your Vercel Project Settings -> Environment Variables
# Point to your deployed Render backend web service URL:
# VITE_API_BASE_URL=https://rescuebite-backend.onrender.com/api

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
